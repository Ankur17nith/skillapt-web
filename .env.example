# Copy to .env.local for local development. All VITE_* values are public (bundled into the site).

# Registry API base URL. Leave empty for demo mode (bundled sample data).
# Local registry:  http://localhost:8787
# Deployed:        https://<registry-worker>.<your-subdomain>.workers.dev
VITE_REGISTRY_URL=

# Public origin of this site (enables canonical URLs, sitemap.xml, Open Graph image URLs).
# Leave empty until you have a stable URL.
VITE_SITE_URL=
